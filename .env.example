# Copy to .env.local and fill with credentials created for THIS installation.
# Never commit .env.local or copy another project's .env file.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional providers; configure only after choosing who pays for them.
# DEEPSEEK_API_KEY também alimenta o gate de qualidade por LLM-judge (score 0-100,
# 5 categorias) antes da publicação — sem ela, tanto a geração quanto o gate são pulados.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Lead capture — Trello CRM plugin (see /setup for the checklist)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Post-publish distribution plugins (see /setup for the checklist)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_DIGEST_WEBHOOK_URL=
SOCIAL_WEBHOOK_URL=
